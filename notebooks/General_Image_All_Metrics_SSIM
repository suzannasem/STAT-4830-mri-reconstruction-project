taLoader(PairDataset(x_train, y_train), batch_size=4, shuffle=True)\n","diff_val_loader = DataLoader(PairDataset(x_val, y_val), batch_size=4, shuffle=False)\n","diff_test_loader = DataLoader(PairDataset(x_test, y_test), batch_size=4, shuffle=False)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"I8WMRVGcCh1m"},"outputs":[],"source":["def data_consistency_projection(x, y_obs, mask):\n","  \"\"\"\n","  x: [B, 1, H, W] is the real image estimate\n","  y_obs: [B, 1, H, W] is the complex undersampled Fourier measurements\n","  mask: [H, W] or [1, H, W] or [B, 1, H, W]\n","  \"\"\"\n","  k = torch.fft.fftshift(torch.fft.fft2(x, dim=(-2, -1)), dim=(-2, -1))\n","\n","  if mask.dim() == 2:\n","    mask_exp = mask.unsqueeze(0).unsqueeze(0)\n","  elif mask.dim() == 3:\n","    mask_exp = mask.unsqueeze(0)\n","  else:\n","    mask_exp = mask\n","\n","  mask_exp = mask_exp.to(x.device)\n","\n","  # this enforces observed k-space, only modify unobserved region\n","  k_proj = mask_exp * y_obs + (1.0 - mask_exp) * k\n","  x_proj = torch.fft.ifft2(torch.fft.ifftshift(k_proj, dim=(-2, -1)), dim=(-2,-1)).real\n","\n","  return torch.clamp(x_proj, 0.0, 1.0)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"1Lf9s0JvCjKx"},"outputs":[],"source":["T = 100\n","\n","betas = torch.linspace(1e-4, 2e-2, T, device=device)\n","alphas = 1.0 - betas\n","alpha_bars = torch.cumprod(alphas, dim=0)\n","\n","def extract(a, t, x_shape):\n","  \"\"\"\n","  a: [T]\n","  t: [B]\n","  returns shape [B, 1, 1, 1] for broadcasting\n","  \"\"\"\n","  out = a.gather(0, t)\n","  return out.view(-1, 1, 1, 1)\n","\n","def q_sample(x0, t, noise=None):\n","  \"\"\"\n","  Forward diffusion:\n","  x_t=sqrt(alpha_bar_t) x0 + sqrt(1-alpha_bar_t) eps\n","  \"\"\"\n","  if noise is None:\n","    noise = torch.randn_like(x0)\n","\n","  sqrt_ab = torch.sqrt(extract(alpha_bars, t, x0.shape))\n","  sqrt_1mab = torch.sqrt(1.0 - extract(alpha_bars, t, x0.shape))\n","  return sqrt_ab * x0 + sqrt_1mab * noise, noise"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"g91Q7ASWCkua"},"outputs":[],"source":["# timestep\n","class SinusoidalTimeEmbedding(nn.Module):\n","  def __init__(self, dim):\n","    super().__init__()\n","    self.dim = dim\n","\n","  def forward(self, t):\n","    half_dim = self.dim // 2\n","    emb_scale = math.log(10000) / (half_dim - 1)\n","    emb = torch.exp(torch.arange(half_dim, device=t.device) * -emb_scale)\n","    emb = t.float().unsqueeze(1) * emb.unsqueeze(0)\n","    emb = torch.cat([torch.sin(emb), torch.cos(emb)], dim=1)\n","    return emb"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"q5WuY9YQCmEH"},"outputs":[],"source":["# kernel denoiser\n","class DiffusionKernelDenoiser(nn.Module):\n","  def __init__(self, in_channels=3, time_dim=64, ch=64):\n","    super().__init__()\n","    self.in_channels = in_channels\n","\n","    self.time_mlp = nn.Sequential(\n","        SinusoidalTimeEmbedding(time_dim),\n","        nn.Linear(time_dim, time_dim),\n","        nn.ReLU(inplace=True),\n","        nn.Linear(time_dim, time_dim),\n","    )\n","\n","    self.conv1 = nn.Conv2d(2 * in_channels, ch, 3, padding=1)  # [x_t, x_kernel]\n","    self.conv2 = nn.Conv2d(ch, ch, 3, padding=1)\n","    self.conv3 = nn.Conv2d(ch, ch, 3, padding=1)\n","    self.conv4 = nn.Conv2d(ch, in_channels, 3, padding=1)\n","\n","    self.time_proj1 = nn.Linear(time_dim, ch)\n","    self.time_proj2 = nn.Linear(time_dim, ch)\n","    self.time_proj3 = nn.Linear(time_dim, ch)\n","\n","    self.act = nn.ReLU(inplace=True)\n","\n","  def forward(self, x_t, x_kernel, t):\n","    temb = self.time_mlp(t)\n","    h = torch.cat([x_t, x_kernel], dim=1)\n","\n","    h = self.conv1(h)\n","    h = h + self.time_proj1(temb).unsqueeze(-1).unsqueeze(-1)\n","    h = self.act(h)\n","\n","    h = self.conv2(h)\n","    h = h + self.time_proj2(temb).unsqueeze(-1).unsqueeze(-1)\n","    h = self.act(h)\n","\n","    h = self.conv3(h)\n","    h = h + self.time_proj3(temb).unsqueeze(-1).unsqueeze(-1)\n","    h = self.act(h)\n","\n","    eps_pred = self.conv4(h)\n","    return eps_pred"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"nZ32yYelCnkl","outputId":"d3aca2d0-2ed5-40a5-df8e-4688a9ef1ea8"},"outputs":[{"name":"stdout","output_type":"stream","text":["DiffusionKernelDenoiser(\n","  (time_mlp): Sequential(\n","    (0): SinusoidalTimeEmbedding()\n","    (1): Linear(in_features=64, out_features=64, bias=True)\n","    (2): ReLU(inplace=True)\n","    (3): Linear(in_features=64, out_features=64, bias=True)\n","  )\n","  (conv1): Conv2d(6, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","  (conv2): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","  (conv3): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","  (conv4): Conv2d(64, 3, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","  (time_proj1): Linear(in_features=64, out_features=64, bias=True)\n","  (time_proj2): Linear(in_features=64, out_features=64, bias=True)\n","  (time_proj3): Linear(in_features=64, out_features=64, bias=True)\n","  (act): ReLU(inplace=True)\n",")\n"]}],"source":["model_diff = DiffusionKernelDenoiser(in_channels=target_images.shape[1], time_dim=64, ch=64).to(device)\n","print(model_diff)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"31XcTnNECpHT","outputId":"1afd3699-9ea5-4ba5-9d24-4c495c848d2b"},"outputs":[{"name":"stdout","output_type":"stream","text":["Epoch 01/50 | Train Loss: 0.995558 | Val Loss: 0.963769\n","Epoch 02/50 | Train Loss: 0.974207 | Val Loss: 0.939225\n","Epoch 03/50 | Train Loss: 0.956380 | Val Loss: 0.936800\n","Epoch 04/50 | Train Loss: 0.870303 | Val Loss: 0.835095\n","Epoch 05/50 | Train Loss: 0.775872 | Val Loss: 0.747000\n","Epoch 06/50 | Train Loss: 0