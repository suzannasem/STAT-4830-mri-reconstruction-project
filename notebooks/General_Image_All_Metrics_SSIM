e","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"Hi6DmztxFiYL","outputId":"79f2df15-e016-4a5a-f245-27aa8cfe1517"},"outputs":[{"name":"stdout","output_type":"stream","text":["x_train_zf: torch.Size([8, 3, 256, 256]) y_train: torch.Size([8, 3, 256, 256])\n","x_val_zf: torch.Size([3, 3, 256, 256]) y_val: torch.Size([3, 3, 256, 256])\n","x_test_zf: torch.Size([3, 3, 256, 256]) y_test: torch.Size([3, 3, 256, 256])\n"]}],"source":["# train / val / test\n","x_train_zf = torch.stack([zf_recon_dict[i] for i in train_indices], dim=0).float()\n","y_train = target_images[train_indices].cpu().float()\n","\n","x_val_zf = torch.stack([zf_recon_dict[i] for i in val_indices], dim=0).float()\n","y_val = target_images[val_indices].cpu().float()\n","\n","x_test_zf = torch.stack([zf_recon_dict[i] for i in test_indices], dim=0).float()\n","y_test = target_images[test_indices].cpu().float()\n","\n","print(\"x_train_zf:\", x_train_zf.shape, \"y_train:\", y_train.shape)\n","print(\"x_val_zf:\", x_val_zf.shape, \"y_val:\", y_val.shape)\n","print(\"x_test_zf:\", x_test_zf.shape, \"y_test:\", y_test.shape)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"kUAubzq0Fj6o"},"outputs":[],"source":["class PairDataset(Dataset):\n","  def __init__(self, x, y):\n","    self.x = x\n","    self.y = y\n","\n","  def __len__(self):\n","    return len(self.x)\n","\n","  def __getitem__(self, idx):\n","    return self.x[idx], self.y[idx]\n","\n","diff_train_loader_zf = DataLoader(PairDataset(x_train_zf, y_train), batch_size=4, shuffle=True)\n","diff_val_loader_zf = DataLoader(PairDataset(x_val_zf, y_val), batch_size=4, shuffle=False)\n","diff_test_loader_zf = DataLoader(PairDataset(x_test_zf, y_test), batch_size=4, shuffle=False)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"Zupy1CfyFl49"},"outputs":[],"source":["# Fourier-domain data consistency (channel-aware)\n","def data_consistency_projection(x, y_obs, mask):\n","  \"\"\"\n","  x: [B, C, H, W] is the real image estimate\n","  y_obs: [B, C, H, W] is the complex undersampled Fourier measurements\n","  mask: [H, W] or [1, H, W] or [B, 1, H, W]\n","  \"\"\"\n","  k = torch.fft.fftshift(torch.fft.fft2(x, dim=(-2, -1)), dim=(-2, -1))\n","\n","  if mask.dim() == 2:\n","    mask_exp = mask.unsqueeze(0).unsqueeze(0)\n","  elif mask.dim() == 3:\n","    mask_exp = mask.unsqueeze(0)\n","  else:\n","    mask_exp = mask\n","\n","  mask_exp = mask_exp.to(x.device)\n","\n","  k_proj = mask_exp * y_obs + (1.0 - mask_exp) * k\n","  x_proj = torch.fft.ifft2(torch.fft.ifftshift(k_proj, dim=(-2, -1)), dim=(-2, -1)).real\n","\n","  return torch.clamp(x_proj, 0.0, 1.0)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"L5zxKUqvFnyZ"},"outputs":[],"source":["# diffusion set up (same as kernel)\n","T = 100\n","\n","betas = torch.linspace(1e-4, 2e-2, T, device=device)\n","alphas = 1.0 - betas\n","alpha_bars = torch.cumprod(alphas, dim=0)\n","\n","def extract(a, t, x_shape):\n","  \"\"\"\n","  a: [T]\n","  t: [B]\n","  returns shape [B, 1, 1, 1] for broadcasting\n","  \"\"\"\n","  out = a.gather(0, t)\n","  return out.view(-1, 1, 1, 1)\n","\n","def q_sample(x0, t, noise=None):\n","  \"\"\"\n","  Forward diffusion:\n","  x_t=sqrt(alpha_bar_t) x0 + sqrt(1-alpha_bar_t) eps\n","  \"\"\"\n","  if noise is None:\n","    noise = torch.randn_like(x0)\n","\n","  sqrt_ab = torch.sqrt(extract(alpha_bars, t, x0.shape))\n","  sqrt_1mab = torch.sqrt(1.0 - extract(alpha_bars, t, x0.shape))\n","  return sqrt_ab * x0 + sqrt_1mab * noise, noise"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"dcAHLi-IFpdO"},"outputs":[],"source":["# timestep again same as kernel reconstruction\n","class SinusoidalTimeEmbedding(nn.Module):\n","  def __init__(self, dim):\n","    super().__init__()\n","    self.dim = dim\n","\n","  def forward(self, t):\n","    half_dim = self.dim // 2\n","    emb_scale = math.log(10000) / (half_dim - 1)\n","    emb = torch.exp(torch.arange(half_dim, device=t.device) * -emb_scale)\n","    emb = t.float().unsqueeze(1) * emb.unsqueeze(0)\n","    emb = torch.cat([torch.sin(emb), torch.cos(emb)], dim=1)\n","    return emb"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"mxVu2j3QFriD"},"outputs":[],"source":["# zero-filled denoiser\n","class DiffusionZFDenoiser(nn.Module):\n","  def __init__(self, in_channels=3, time_dim=64, ch=64):\n","    super().__init__()\n","    self.in_channels = in_channels\n","\n","    self.time_mlp = nn.Sequential(\n","        SinusoidalTimeEmbedding(time_dim),\n","        nn.Linear(time_dim, time_dim),\n","        nn.ReLU(inplace=True),\n","        nn.Linear(time_dim, time_dim),\n","    )\n","\n","    self.conv1 = nn.Conv2d(2 * in_channels, ch, 3, padding=1)  # [x_t, x_zf]\n","    self.conv2 = nn.Conv2d(ch, ch, 3, padding=1)\n","    self.conv3 = nn.Conv2d(ch, ch, 3, padding=1)\n","    self.conv4 = nn.Conv2d(ch, in_channels, 3, padding=1)\n","\n","    self.time_proj1 = nn.Linear(time_dim, ch)\n","    self.time_proj2 = nn.Linear(time_dim, ch)\n","    self.time_proj3 = nn.Linear(time_dim, ch)\n","\n","    self.act = nn.ReLU(inplace=True)\n","\n","  def forward(self, x_t, x_zf, t):\n","    temb = self.time_mlp(t)\n","    h = torch.cat([x_t, x_zf], dim=1)\n","\n","    h = self.conv1(h)\n","    h = h + self.time_proj1(temb).unsqueeze(-1).unsqueeze(-1)\n","    h = self.act(h)\n","\n","    h = self.conv2(h)\n","    h = h + self.time_proj2(temb).unsqueeze(-1).unsqueeze(-1)\n","    h = self.act(h)\n","\n","    h = self.conv3(h)\n","    h = h + self.time_proj3(temb).unsqueeze(-1).unsqueeze(-1)\n","    h = self.act(h)\n","\n","    eps_pred = self.conv4(h)\n","    return eps_pred"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"MTOBeCKDFt_q","outputId":"357d07dd-e970-4bda-a6fc-aa332afc7