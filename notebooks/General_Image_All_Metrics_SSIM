st.shape, \"y_test: \", y_test.shape)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"4k4kfPWImDdK"},"outputs":[],"source":["from torch.utils.data import Dataset, DataLoader\n","\n","class PairDataset(Dataset):\n","  def __init__(self, x, y):\n","    self.x = x.float()\n","    self.y = y.float()\n","\n","  def __len__(self):\n","    return self.x.shape[0]\n","\n","  def __getitem__(self, i):\n","    return self.x[i], self.y[i]\n","\n","train_loader = DataLoader(PairDataset(x_train, y_train), batch_size=4, shuffle=True)\n","val_loader = DataLoader(PairDataset(x_val, y_val), batch_size=4, shuffle=False)\n","test_loader = DataLoader(PairDataset(x_test, y_test), batch_size=4, shuffle=False)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"ZzjnPQcSmFqC"},"outputs":[],"source":["def data_consistency(x, y_obs, mask):\n","  \"\"\"\n","  x: [B, C, H, W] real image\n","  y_obs: [B, C, H, W] complex undersampled Fourier measurements\n","  mask: [H, W] or [1, H, W] real/bool sampling mask\n","  \"\"\"\n","  k = torch.fft.fftshift(torch.fft.fft2(x, dim=(-2, -1)), dim=(-2, -1))\n","\n","  if mask.dim() == 2:\n","    mask_exp = mask.unsqueeze(0).unsqueeze(0)\n","  elif mask.dim() == 3:\n","    mask_exp = mask.unsqueeze(0)\n","  else:\n","    mask_exp = mask\n","\n","  mask_exp = mask_exp.to(x.device)\n","  k_dc = (1.0 - mask_exp) * k + mask_exp * y_obs\n","\n","  x_dc = torch.fft.ifft2(torch.fft.ifftshift(k_dc, dim=(-2,-1)), dim=(-2,-1)).real\n","  return torch.clamp(x_dc, 0.0, 1.0)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"nwo-KGpSmICH","outputId":"0817f504-8dce-4b28-9726-977ab8b006b7"},"outputs":[{"name":"stdout","output_type":"stream","text":["KernelResidualCNN_DC(\n","  (net): Sequential(\n","    (0): Conv2d(3, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (1): ReLU(inplace=True)\n","    (2): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (3): ReLU(inplace=True)\n","    (4): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (5): ReLU(inplace=True)\n","    (6): Conv2d(64, 3, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","  )\n",")\n"]}],"source":["class KernelResidualCNN_DC(nn.Module):\n","  def __init__(self, in_channels=3, ch=64):\n","    super().__init__()\n","    self.net = nn.Sequential(\n","        nn.Conv2d(in_channels, ch, 3, padding=1),\n","        nn.ReLU(inplace=True),\n","        nn.Conv2d(ch, ch, 3, padding=1),\n","        nn.ReLU(inplace=True),\n","        nn.Conv2d(ch, ch, 3, padding=1),\n","        nn.ReLU(inplace=True),\n","        nn.Conv2d(ch, in_channels, 3, padding=1)\n","    )\n","\n","  def forward(self, x_kernel, y_obs, mask):\n","    residual = self.net(x_kernel)\n","    x_cnn = x_kernel + residual\n","    x_dc = data_consistency(x_cnn, y_obs, mask)\n","    return torch.clamp(x_dc, 0.0, 1.0)\n","\n","model_kernel = KernelResidualCNN_DC(in_channels=target_images.shape[1], ch=64).to(device)\n","print(model_kernel)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"daoEcOxOmKf7"},"outputs":[],"source":["def compute_mse(pred, target):\n","  return F.mse_loss(pred, target)\n","\n","def compute_psnr(pred, target):\n","  mse = compute_mse(pred, target)\n","  return 10 * torch.log10(1.0 / (mse + 1e-12))\n","\n","def compute_metrics(pred, target):\n","  \"\"\"\n","  Computes all reconstruction metrics in one place.\n","  pred, target should be [B, C, H, W] or [C, H, W] in [0, 1].\n","  \"\"\"\n","  if pred.dim() == 3:\n","    pred = pred.unsqueeze(0)\n","  if target.dim() == 3:\n","    target = target.unsqueeze(0)\n","\n","  pred = pred.float().clamp(0, 1)\n","  target = target.float().clamp(0, 1)\n","\n","  mse = compute_mse(pred, target)\n","  psnr = compute_psnr(pred, target)\n","  ssim = compute_ssim(pred, target)\n","\n","  return {\n","      \"mse\": mse.item(),\n","      \"psnr\": psnr.item(),\n","      \"ssim\": ssim.item(),\n","  }\n","\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"GpjWs5DrgOZS"},"outputs":[],"source":["def ssim_loss(pred, target, data_range=1.0, window_size=11, sigma=1.5, eps=1e-12):\n","    \"\"\"\n","    Differentiable SSIM loss = 1 - SSIM(pred, target).\n","    pred, target: [B, C, H, W] float tensors in [0, data_range].\n","    \"\"\"\n","    return 1.0 - compute_ssim(pred, target, data_range=data_range,\n","                              window_size=window_size, sigma=sigma, eps=eps)\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"AablaBoFmOAk","outputId":"6af674a9-f3c6-45af-9793-b5bd7de69a3a"},"outputs":[{"name":"stdout","output_type":"stream","text":["Epoch 000 | train SSIM-loss=0.126015, train PSNR=31.48 dB, train SSIM=0.8740 | val SSIM-loss=0.125230, val PSNR=32.17 dB, val SSIM=0.8748\n","Epoch 005 | train SSIM-loss=0.124140, train PSNR=31.59 dB, train SSIM=0.8759 | val SSIM-loss=0.124437, val PSNR=32.22 dB, val SSIM=0.8756\n","Epoch 010 | train SSIM-loss=0.123155, train PSNR=31.70 dB, train SSIM=0.8768 | val SSIM-loss=0.124157, val PSNR=32.25 dB, val SSIM=0.8758\n","Epoch 015 | train SSIM-loss=0.122437, train PSNR=31.98 dB, train SSIM=0.8776 | val SSIM-loss=0.124230, val PSNR=32.25 dB, val SSIM=0.8758\n","Epoch 020 | train SSIM-loss=0.121896, train PSNR=31.83 dB, train SSIM=0.8781 | val SSIM-loss=0.124083, val PSNR=32.25 dB, val SSIM=0.8759\n","Epoch 025 | train SSIM-loss=0.121052, train PSNR=31.80 dB, train SSIM=0.8789 | val SSIM-loss=0.124093, val PSNR=32.25 dB, val SSIM=0.8759\n","Epoch 030 | train SSIM-loss=0.120653, train PSNR=31.76 dB, train SSIM=0.8793 | val SSIM-loss=0.124570, val PSNR=32.22 dB, val SSIM=0.8754\n","Epoch 035 | train SSIM-loss=0.119855, train PSNR=31.87 dB, train SSIM=0.8801 | val SSIM-loss=0.124726, val PSNR=32.19 dB, val SSIM=0.8753\n","Epoch 040 | tra