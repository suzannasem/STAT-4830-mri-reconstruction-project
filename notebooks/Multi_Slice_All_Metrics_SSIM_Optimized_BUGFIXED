e:\n","  y_obs = k_full * mask_t\n","\n","model_kernel.eval()\n","with torch.no_grad():\n","  y_pred = model_kernel(x_kernel, y_obs, mask_t)\n","\n","psnr_before = compute_psnr(x_kernel, y_true).item()\n","psnr_after = compute_psnr(y_pred, y_true).item()\n","ssim_before = compute_ssim(x_kernel, y_true).item()\n","ssim_after = compute_ssim(y_pred, y_true).item()\n","\n","kernel_np = x_kernel.squeeze().detach().cpu().numpy()\n","pred_np = y_pred.squeeze().detach().cpu().numpy()\n","true_np = y_true.squeeze().detach().cpu().numpy()\n","\n","fig, axes = plt.subplots(1, 3, figsize=(15,5))\n","\n","axes[0].imshow(true_np, cmap=\"gray\")\n","axes[0].set_title(\"Ground Truth\")\n","axes[0].axis(\"off\")\n","\n","axes[1].imshow(kernel_np, cmap=\"gray\")\n","axes[1].set_title(f\"Kernel Baseline\\nPSNR={psnr_before:.2f} dB, SSIM={ssim_before:.4f}\")\n","axes[1].axis(\"off\")\n","\n","axes[2].imshow(pred_np, cmap=\"gray\")\n","axes[2].set_title(f\"Kernel + Residual CNN\\nPSNR={psnr_after:.2f} dB, SSIM={ssim_after:.4f}\")\n","axes[2].axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"PSNR before CNN: {psnr_before:.2f} dB\")\n","print(f\"PSNR after CNN: {psnr_after:.2f} dB\")\n","print(f\"Improvement: {psnr_after - psnr_before:+.2f} dB\")"]},{"cell_type":"markdown","metadata":{"id":"QrBFbO-97q-8"},"source":["# Zero-Filled FFT Residual Neural Network\n","\n","This section repeats the same residual-learning idea, but now the warm start is the zero-filled FFT reconstruction instead of the kernel reconstruction. This gives a fairer way to compare whether the kernel prior provides a better starting point for the CNN. Additionally, since the zero-filled FFT reconstruction was better and computationally less expensive on it's own, this may provide another perspective to image reconstruction that is fast and not computationally expensive."]},{"cell_type":"markdown","metadata":{"id":"K2v3Pzl47x3M"},"source":["**Note**: can also be slow since it processes every slice in the selected subset."]},{"cell_type":"code","execution_count":32,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":15,"status":"ok","timestamp":1777786165448,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"6Qo8zaZ77php","outputId":"c0e087e9-3a7f-4405-92e2-0c10578d4949"},"outputs":[{"output_type":"stream","name":"stdout","text":["Building zero-filled slice 16 (1/14)\n","Building zero-filled slice 18 (2/14)\n","Building zero-filled slice 19 (3/14)\n","Building zero-filled slice 21 (4/14)\n","Building zero-filled slice 22 (5/14)\n","Building zero-filled slice 27 (6/14)\n","Building zero-filled slice 33 (7/14)\n","Building zero-filled slice 40 (8/14)\n","Building zero-filled slice 41 (9/14)\n","Building zero-filled slice 44 (10/14)\n","Building zero-filled slice 57 (11/14)\n","Building zero-filled slice 75 (12/14)\n","Building zero-filled slice 78 (13/14)\n","Building zero-filled slice 93 (14/14)\n"]}],"source":["# build zero-filled FFT reconstructions for slices used by CNN\n","\n","needed_indices = sorted(set(train_indices + val_indices + test_indices))\n","zf_recon_dict = {}\n","\n","mask_t = mask.to(device)\n","\n","for count, i in enumerate(needed_indices):\n","  print(f\"Building zero-filled slice {i} ({count+1}/{len(needed_indices)})\")\n","\n","  target_slice = target_images[i, 0].to(device).float()\n","\n","  k_full = torch.fft.fftshift(torch.fft.fft2(target_slice, dim=(-2,-1)), dim=(-2,-1))\n","  y_obs = k_full * mask_t\n","\n","  x_zf_complex = torch.fft.ifft2(torch.fft.ifftshift(y_obs, dim=(-2,-1)), dim=(-2,-1))\n","  x_zf = x_zf_complex.real\n","  x_zf = torch.clamp(x_zf, 0.0, 1.0)\n","\n","  zf_recon_dict[i] = x_zf.detach().cpu().float().clamp(0,1)"]},{"cell_type":"code","execution_count":33,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":11,"status":"ok","timestamp":1777786165462,"user":{"displayName":"Sydney Bergstrom","userId":"1