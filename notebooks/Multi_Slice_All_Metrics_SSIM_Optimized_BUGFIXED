alues\": 3,\n        \"samples\": [\n          \"Zero-filled FFT baseline\",\n          \"Laplacian kernel\",\n          \"Gaussian kernel\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"MSE\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.003133038895257177,\n        \"min\": 0.0025701778940856457,\n        \"max\": 0.008527098223567009,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0.0025701778940856457,\n          0.008527098223567009,\n          0.0072321235202252865\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"PSNR\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2.8232967608908983,\n        \"min\": 20.691982250430044,\n        \"max\": 25.900351263256066,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          25.900351263256066,\n          20.691982250430044,\n          21.407335644793495\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"SSIM\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.05283169506872121,\n        \"min\": 0.48144733905792236,\n        \"max\": 0.583585798740387,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0.583585798740387,\n          0.48144733905792236,\n          0.5090780258178711\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x500 with 4 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# ---- Test Slice Comparison: Laplacian vs Gaussian vs Zero-Filled FFT ----\n","# Ground truth is the reference; zero-filled FFT is the simple baseline.\n","\n","# Choose test slice\n","test_idx = representative_test_idx if \"representative_test_idx\" in globals() else test_indices[0]\n","target = target_images[test_idx, 0].to(device)\n","\n","# Pick which hyperparameters you want to compare.\n","# These are your MSE-optimized values:\n","lap_params = {\n","    \"sigma\": 2.12,\n","    \"num_kernels\": 4034,\n","    \"lambda_tv\": 2.42e-7,\n","}\n","\n","gauss_params = {\n","    \"sigma\": 2.0,\n","    \"num_kernels\": 3969,\n","    \"lambda_tv\": 4.49e-7,\n","}\n","\n","# Reconstruct Laplacian\n","lap_out = kernel_opt.reconstruct_single_slice(\n","    target,\n","    sigma=lap_params[\"sigma\"],\n","    num_kernels=lap_params[\"num_kernels\"],\n","    lambda_tv=lap_params[\"lambda_tv\"],\n","    max_iter=100,\n","    lr=0.01,\n","    kernel_type=\"laplacian\",\n",")\n","\n","x_lap = lap_out[\"reconstruction\"].detach().to(device)\n","\n","# Reconstruct Gaussian\n","gauss_out = kernel_opt.reconstruct_single_slice(\n","    target,\n","    sigma=gauss_params[\"sigma\"],\n","    num_kernels=gauss_params[\"num_kernels\"],\n","    lambda_tv=gauss_params[\"lambda_tv\"],\n","    max_iter=100,\n","    lr=0.01,\n","    kernel_type=\"gaussian\",\n",")\n","\n","x_gauss = gauss_out[\"reconstruction\"].detach().to(device)\n","\n","# Zero-filled FFT baseline\n","def zero_filled_reconstruction(img, mask):\n","    if img.dim() == 3:\n","        img = img[0]\n","\n","    mask_real = mask.real if torch.is_complex(mask) else mask\n","    mask_real = mask_real.to(img.device)\n","\n","    k_full = torch.fft.fftshift(torch.fft.fft2(img), dim=(-2, -1))\n","    k_under = k_full * mask_real\n","\n","    x_zf = torch.fft.ifft2(\n","        torch.fft.ifftshift(k_under, dim=(-2, -1)),\n","        dim=(-2, -1)\n","    ).real\n","\n","    return torch.clamp(x_zf, 0.0, 1.0)\n","\n","x_zf = zero_filled_reconstruction(target, mask).detach().to(device)\n","\n","# Add batch/channel dimensions for metrics\n","target_bc = target.unsqueeze(0).unsqueeze(0)\n","x_lap_bc = x_lap.unsqueeze(0).unsqueeze(0)\n","x_gauss_bc = x_gauss.unsqueeze(0).unsqueeze(0)\n","x_zf_bc = x_zf.unsqueeze(0).unsqueeze(0)\n","\n","# Metrics table\n","import math\n","\n","def get_metrics(x, y):\n","    mse = torch.mean((x - y)**2).item()\n","    psnr = 10 * math.log10(1.0 / (mse + 1e-8))\n","    ssim = compute_ssim(\n","        x.unsqueeze(0).unsqueeze(0),\n","        y.unsqueeze(0).unsqueeze(0)\n","    ).item()\n","\n","    return {\"MSE\": mse, \"PSNR\": psnr, \"SSIM\": ssim}\n","\n","\n","results = pd.DataFrame([\n","    {\"Method\": \"Zero-filled FFT baseline\", **get_metrics(x_zf, target)},\n","    {\"Method\": \"Laplacian kernel\", **get_metrics(x_lap, target)},\n","    {\"Method\": \"Gaussian kernel\", **get_metrics(x_gauss, target)},\n","])\n","\n","display(results)\n","\n","display(results)\n","\n","# Visualization\n","fig, axes = plt.subplots(1, 4, figsize=(18, 5))\n","\n","axes[0].imshow(target.detach().cpu(), cmap=\"gray\")\n","axes[0].set_title(\"Ground Truth\")\n","axes[0].axis(\"off\")\n","\n","axes[1].imshow(x_zf.detach().cpu(), cmap=\"gray\")\n","axes[1].set_title(\"Zero-Filled FFT\")\n","axes[1].axis(\"off\")\n","\n","axes[2].imshow(x_lap.detach().cpu(), cmap=\"gray\")\n","axes[2].set_title(\"Laplacian Kernel\")\n","axes[2].axis(\"off\")\n","\n","axes[3].imshow(x_gauss.detach().cpu(), cmap=\"gray\")\n","axes[3].set_title(\"Gaussian Kernel\")\n","axes[3].axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","metadata":{"id":"cS3C7qyFaDge"},"source":["## Success Metrics\n","\n","The reconstruction methods are evaluated with all three metrics:\n","* **Mean Squared Error (MSE):** Lower is better and measures average pixel-wise squared error.\n","* **Peak Signal-to-Noise Ratio (PSNR):** Higher is better and is computed from MSE.\n","* **Structural Similarity Index (SSIM):** Higher is better and measures structural/perceptual similarity.\n","\n","In this notebook, the kernel hyperparameter search optimizes **SSIM**, but all three metrics are computed and reported for each trial and final reconstruction.\n"]},{"cell_type":"markdown","metadata":{"id":"LB7oYaK8aJka"},"source":["## Resource Monitoring\n","\n","The cells that take long were noted above. If memory becomes an issue, reduce the number of slices, number of kernels, or training epochs.\n","\n","\n","\n"]},{"cell_type":"markdown","metadata":{"id":"JuAGguyVaLwn"},"source":["# Residual CNN with Kernel Reconstructions\n","\n","This section trains a CNN to predict a residual correction to the kernel reconstruction. The corrected image is then projected back to match the observed k-space values using a data consistency step.\n","\n","Overall:\n","- the kernel method provides a structured warm start\n","- the CNN fills in image-domain details\n","- data consistency prevents the network from changing measurements that were actually observed\n","\n"]},{"cell_type":"code","execution_count":21,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":16,"status":"ok","timestamp":1777785982477,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"SmGzhHYkZ9zK","outputId":"7f8d50a9-7c0b-4462-f104-0605e6e689f9"},"outputs":[{"output_type":"stream","name":"stdout","text":["Train: [57, 21, 75, 18, 33, 40, 93, 27]\n","Val: [16, 44, 78]\n","Test: [41, 22, 19]\n"]}],"source":["# trims the number of slices used by the kernel-residual CNN\n","# used to keep training doable\n","train_indices = train_indices[:8]\n","val_indices   = val_indices[:3]\n","test_indices  = test_indices[:3]\n","\n","print(\"Train:\", train_indices)\n","print(\"Val:\", val_indices)\n","print(\"Test:\", test_indices)"]},{"cell_type":"markdown","metadata":{"id":"a_YOAOMk6Z5J"},"source":["For each slice in the CNN subset, we first compute the kernel reconstruction that will serve as the model input.\n","\n","**Note**: this can be slow because it reconstructs many slices before training even begins"]},{"cell_type":"code","execution_count":22,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":109153,"status":"ok","timestamp":1777786091633,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"DqV4ULSO6baS","outputId":"ba428f60-e10e-4fdc-c41a-eb7bd6d3247c"},"outputs":[{"output_type":"stream","name":"stdout","text":["Reconstructing slice 16 (1/14)\n","Reconstructing slice 18 (2/14)\n","Reconstructing slice 19 (3/14)\n","Reconstructing slice 21 (4/14)\n","Reconstructing slice 22 (5/14)\n","Reconstructing slice 27 (6/14)\n","Reconstructing slice 33 (7/14)\n","Reconstructing slice 40 (8/14)\n","Reconstructing slice 41 (9/14)\n","Reconstructing slice 44 (10/14)\n","Reconstructing slice 57 (11/14)\n","Reconstructing slice 75 (12/14)\n","Reconstructing slice 78 (13/14)\n","Reconstructing slice 93 (14/14)\n"]}],"source":[" # build kernel reconstruction only for slices used by CNN\n","needed_indices = sorted(set(train_indices + val_indices + test_indices))\n","\n","kernel_recon_dict = {}\n","\n","kernel_opt = MultiSliceKernelOptimizer(target_images, mask, device=device)\n","\n","for count, i in enumerate(needed_indices):\n","  print(f\"Reconstructing slice {i} ({count+1}/{len(needed_indices)})\")\n","\n","  out = kernel_opt.reconstruct_single_slice(\n","      target_images[i,0],\n","      sigma=BEST_SIGMA,\n","      num_kernels=BEST_NUM_KERNELS,\n","      lambda_tv=BEST_LAMBDA_TV,\n","      max_iter=100,\n","      lr=0.01,\n","      return_history=False\n","  )\n","\n","  kernel_recon_dict[i] = out[\"reconstruction\"].detach().cpu().float().clamp(0,1)"]},{"cell_type":"code","execution_count":23,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":13,"status":"ok","timestamp":1777786091655,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"1MQgluee6lWW","outputId":"5b97ad4c-b4e5-4c3f-a3b9-1239ffa6f535"},"outputs":[{"output_type":"stream","name":"stdout","text":["x_train: torch.Size([8, 1, 256, 256]) y_train: torch.Size([8, 1, 256, 256])\n","x_val:  torch.Size([3, 1, 256, 256]) y_val:  torch.Size([3, 1, 256, 256])\n","x_test:  torch.Size([3, 1, 256, 256]) y_test:  torch.Size([3, 1, 256, 256])\n"]}],"source":["# train / val / test tensors for kernel residual learning\n","\n","x_train = torch.stack([kernel_recon_dict[i].unsqueeze(0) for i in train_indices], dim=0)\n","y_train = target_images[train_indices].cpu().float()\n","\n","x_val = torch.stack([kernel_recon_dict[i].unsqueeze(0) for i in val_indices], dim=0)\n","y_val = target_images[val_indices].cpu().float()\n","\n","x_test = torch.stack([kernel_recon_dict[i].unsqueeze(0) for i in test_indices], dim=0)\n","y_test = target_images[test_indices].cpu().float()\n","\n","print(\"x_train:\", x_train.shape, \"y_train:\", y_train.shape)\n","print(\"x_val: \", x_val.shape, \"y_val: \", y_val.shape)\n","print(\"x_test: \", x_test.shape, \"y_test: \", y_test.shape)"]},{"cell_type":"code","execution_count":24,"metadata":{"executionInfo":{"elapsed":3,"status":"ok","timestamp":1777786091664,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"58wqg49d6nnw"},"outputs":[],"source":["from torch.utils.data import Dataset, DataLoader\n","\n","class PairDataset(Dataset):\n","  def __init__(self, x, y):\n","    self.x = x.float()\n","    self.y = y.float()\n","\n","  def __len__(self):\n","    return self.x.shape[0]\n","\n","  def __getitem__(self, i):\n","    return self.x[i], self.y[i]\n","\n","train_loader = DataLoader(PairDataset(x_train, y_train), batch_size=4, shuffle=True)\n","val_loader = DataLoader(PairDataset(x_val, y_val), batch_size=4, shuffle=False)\n","test_loader = DataLoader(PairDataset(x_test, y_test), batch_size=4, shuffle=False)"]},{"cell_type":"markdown","metadata":{"id":"qSeVWKvb6qtP"},"source":["This function replaces the reconstructed k-space values at observed locations with the actual measured values, so the network can't overwrite \"real\" k-space data."]},{"cell_type":"code","execution_count":25,"metadata":{"executionInfo":{"elapsed":4,"status":"ok","timestamp":1777786091671,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"nZcn71QP7Vgr"},"outputs":[],"source":["def data_consistency(x, y_obs, mask):\n","  \"\"\"\n","  x: [B, 1, H, W] real image\n","  y_obs: [B, 1, H, W] complex undersampled k-space\n","  mask: [H, W] or [1, H, W] real/bool sampling mask\n","  \"\"\"\n","  k = torch.fft.fftshift(torch.fft.fft2(x, dim=(-2, -1)), dim=(-2, -1))\n","\n","  # expand mask to [B, 1, H, W]\n","  if mask.dim() == 2:\n","    mask_exp = mask.unsqueeze(0).unsqueeze(0)\n","  elif mask.dim() == 3:\n","    mask_exp = mask.unsqueeze(0)\n","  else:\n","    mask_exp = mask\n","\n","  mask_exp = mask_exp.to(x.device)\n","\n","  # keep measured k-space where mask=1, use CNN output where mask=0\n","  k_dc = (1.0 - mask_exp) * k + mask_exp * y_obs\n","\n","  x_dc = torch.fft.ifft2(torch.fft.ifftshift(k_dc, dim=(-2,-1)), dim=(-2,-1))\n","  x_dc = x_dc.real\n","  return x_dc"]},{"cell_type":"code","execution_count":26,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":20,"status":"ok","timestamp":1777786091694,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"T1ZxxLwl7Vxz","outputId":"a2968ae9-4823-4562-dca3-bdea91e4150d"},"outputs":[{"output_type":"stream","name":"stdout","text":["KernelResidualCNN_DC(\n","  (net): Sequential(\n","    (0): Conv2d(1, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (1): ReLU(inplace=True)\n","    (2): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (3): ReLU(inplace=True)\n","    (4): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (5): ReLU(inplace=True)\n","    (6): Conv2d(64, 1, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","  )\n",")\n"]}],"source":["class KernelResidualCNN_DC(nn.Module):\n","  def __init__(self, ch=64):\n","    super().__init__()\n","    self.net = nn.Sequential(\n","        nn.Conv2d(1, ch, 3, padding=1),\n","        nn.ReLU(inplace=True),\n","        nn.Conv2d(ch, ch, 3, padding=1),\n","        nn.ReLU(inplace=True),\n","        nn.Conv2d(ch, ch, 3, padding=1),\n","        nn.ReLU(inplace=True),\n","        nn.Conv2d(ch, 1, 3, padding=1)\n","    )\n","\n","  def forward(self, x_kernel, y_obs, mask):\n","    residual = self.net(x_kernel)\n","    x_cnn = x_kernel + residual\n","    x_dc = data_consistency(x_cnn, y_obs, mask)\n","    return torch.clamp(x_dc, 0.0, 1.0)\n","\n","model_kernel = KernelResidualCNN_DC(ch=64).to(device)\n","print(model_kernel)"]},{"cell_type":"code","execution_count":27,"metadata":{"executionInfo":{"elapsed":5,"status":"ok","timestamp":1777786091701,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"igNkqNug7X1a"},"outputs":[],"source":["def compute_psnr(pred, target):\n","  mse = F.mse_loss(pred, target)\n","  return 10 * torch.log10(1.0 / (mse + 1e-12))"]},{"cell_type":"code","execution_count":28,"metadata":{"executionInfo":{"elapsed":3,"status":"ok","timestamp":1777786091707,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"d3a8c060"},"outputs":[],"source":["def compute_mse(pred, target):\n","  return F.mse_loss(pred, target)\n","\n","def compute_all_metrics(pred, target):\n","  mse = compute_mse(pred, target)\n","  psnr = 10 * torch.log10(1.0 / (mse + 1e-12))\n","  ssim_val = compute_ssim(pred, target)\n","  return {\n","      \"mse\": mse.item(),\n","      \"psnr\": psnr.item(),\n","      \"ssim\": ssim_val.item(),\n","  }\n"]},{"cell_type":"markdown","metadata":{"id":"UuuPa6aG7c4I"},"source":["**Note**: this can also be long depending on GPU / CPU choice"]},{"cell_type":"code","execution_count":29,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":72859,"status":"ok","timestamp":1777786164569,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"MkfkJkyn7bDZ","outputId":"b3b04368-260f-416e-d4fc-3a3a51543403"},"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 000 | train SSIM-loss=0.416549, train PSNR=26.60 dB, train SSIM=0.5835 | val SSIM-loss=0.415069, val PSNR=26.37 dB, val SSIM=0.5849\n","Epoch 005 | train SSIM-loss=0.355999, train PSNR=27.40 dB, train SSIM=0.6440 | val SSIM-loss=0.377765, val PSNR=26.92 dB, val SSIM=0.6222\n","Epoch 010 | train SSIM-loss=0.344097, train PSNR=27.60 dB, train SSIM=0.6559 | val SSIM-loss=0.365495, val PSNR=27.13 dB, val SSIM=0.6345\n","Epoch 015 | train SSIM-loss=0.338340, train PSNR=27.79 dB, train SSIM=0.6617 | val SSIM-loss=0.361033, val PSNR=27.24 dB, val SSIM=0.6390\n","Epoch 020 | train SSIM-loss=0.336818, train PSNR=27.76 dB, train SSIM=0.6632 | val SSIM-loss=0.357319, val PSNR=27.30 dB, val SSIM=0.6427\n","Epoch 025 | train SSIM-loss=0.335722, train PSNR=27.86 dB, train SSIM=0.6643 | val SSIM-loss=0.357776, val PSNR=27.30 dB, val SSIM=0.6422\n","Epoch 030 | train SSIM-loss=0.331546, train PSNR=27.94 dB, train SSIM=0.6685 | val SSIM-loss=0.355136, val PSNR=27.34 dB, val SSIM=0.6449\n","Epoch 035 | train SSIM-loss=0.329916, train PSNR=27.89 dB, train SSIM=0.6701 | val SSIM-loss=0.354528, val PSNR=27.35 dB, val SSIM=0.6455\n","Epoch 040 | train SSIM-loss=0.329062, train PSNR=27.95 dB, train SSIM=0.6709 | val SSIM-loss=0.353217, val PSNR=27.37 dB, val SSIM=0.6468\n","Epoch 045 | train SSIM-loss=0.328544, train PSNR=27.96 dB, train SSIM=0.6715 | val SSIM-loss=0.352605, val PSNR=27.38 dB, val SSIM=0.6474\n","Epoch 049 | train SSIM-loss=0.328383, train PSNR=27.98 dB, train SSIM=0.6716 | val SSIM-loss=0.350098, val PSNR=27.44 dB, val SSIM=0.6499\n"]}],"source":["# train kernel residual CNN with data consistency\n","optimizer = torch.optim.Adam(model_kernel.parameters(), lr=1e-3)\n","num_epochs = 50\n","\n","train_loss_history = []\n","val_loss_history = []\n","train_psnr_history = []\n","val_psnr_history = []\n","train_ssim_history = []\n","val_ssim_history = []\n","\n","mask_t = mask.to(device)\n","\n","for epoch in range(num_epochs):\n","  model_kernel.train()\n","  running_loss = 0.0\n","  running_psnr = 0.0\n","  running_ssim = 0.0\n","  n_train = 0\n","\n","  for xb, yb in train_loader:\n","    xb = xb.to(device) # kernel baseline\n","    yb = yb.to(device) # ground truth\n","\n","    # simulate observed undersampled k-space from the target\n","    k_full = torch.fft.fftshift(torch.fft.fft2(yb, dim=(-2,-1)), dim=(-2,-1))\n","    if mask_t.dim() == 2:\n","      y_obs = k_full * mask_t.unsqueeze(0).unsqueeze(0)\n","    elif mask_t.dim() == 3:\n","      y_obs = k_full * mask_t.unsqueeze(0)\n","    else:\n","      y_obs = k_full * mask_t\n","\n","    optimizer.zero_grad()\n","    pred = model_kernel(xb, y_obs, mask_t)\n","\n","    loss = ssim_loss(pred, yb)\n","    loss.backward()\n","    optimizer.step()\n","\n","    batch_size = xb.size(0)\n","    running_loss += loss.item() * batch_size\n","    running_psnr += compute_psnr(pred.detach(), yb).item() * batch_size\n","    running_ssim += compute_ssim(pred.detach(), yb).item() * batch_size\n","    n_train += batch_size\n","\n","  train_loss = running_loss / n_train\n","  train_psnr = running_psnr / n_train\n","  train_ssim = running_ssim / n_train\n","\n","  model_kernel.eval()\n","  val_running_loss = 0.0\n","  val_running_psnr = 0.0\n","  val_running_ssim = 0.0\n","  n_val = 0\n","\n","  with torch.no_grad():\n","    for xb, yb in val_loader:\n","      xb = xb.to(device)\n","      yb = yb.to(device)\n","\n","      k_full = torch.fft.fftshift(torch.fft.fft2(yb, dim=(-2,-1)), dim=(-2,-1))\n","      if mask_t.dim() == 2:\n","        y_obs = k_full * mask_t.unsqueeze(0).unsqueeze(0)\n","      elif mask_t.dim() == 3:\n","        y_obs = k_full * mask_t.unsqueeze(0)\n","      else:\n","        y_obs = k_full * mask_t\n","\n","      pred = model_kernel(xb, y_obs, mask_t)\n","      loss = ssim_loss(pred, yb)\n","\n","      batch_size = xb.size(0)\n","      val_running_loss += loss.item() * batch_size\n","      val_running_psnr += compute_psnr(pred, yb).item() * batch_size\n","      val_running_ssim += compute_ssim(pred, yb).item() * batch_size\n","      n_val += batch_size\n","\n","  val_loss = val_running_loss / n_val\n","  val_psnr = val_running_psnr / n_val\n","  val_ssim = val_running_ssim / n_val\n","\n","  train_loss_history.append(train_loss)\n","  val_loss_history.append(val_loss)\n","  train_psnr_history.append(train_psnr)\n","  val_psnr_history.append(val_psnr)\n","  train_ssim_history.append(train_ssim)\n","  val_ssim_history.append(val_ssim)\n","\n","  if epoch % 5 == 0 or epoch == num_epochs - 1:\n","    print(\n","        f\"Epoch {epoch:03d} | \"\n","        f\"train SSIM-loss={train_loss:.6f}, train PSNR={train_psnr:.2f} dB, train SSIM={train_ssim:.4f} | \"\n","        f\"val SSIM-loss={val_loss:.6f}, val PSNR={val_psnr:.2f} dB, val SSIM={val_ssim:.4f}\"\n","    )"]},{"cell_type":"code","execution_count":30,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":184,"status":"ok","timestamp":1777786164757,"user":{"displayName":"Sydney Bergstrom","userId":"12259140351521933020"},"user_tz":240},"id":"a01ifhpD7kK-","outputId":"07739472-8f42-443d-e8ba-a709bc10bdff"},"outputs":[{"output_type":"stream","name":"stdout","text":["Kernel + Residual CNN Test MSE: 0.001826\n","Kernel + Residual CNN Test PSNR: 27.39 dB\n","Kernel + Residual CNN Test SSIM: 0.6374\n"]}],"source":["# test evaluation: compute all success metrics\n","model_kernel.eval()\n","\n","test_running_mse = 0.0\n","test_running_psnr = 0.0\n","test_running_ssim = 0.0\n","n_test = 0\n","\n","with torch.no_grad():\n","  for xb, yb in test_loader:\n","    xb = xb.to(device)\n","    yb = yb.to(device)\n","\n","    k_full = torch.fft.fftshift(torch.fft.fft2(yb, dim=(-2,-1)), dim=(-2,-1))\n","    if mask_t.dim() == 2:\n","      y_obs = k_full * mask_