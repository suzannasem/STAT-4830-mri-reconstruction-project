# # winner = gauss_out if gauss_out[\"best_ssim\"] >= lap_out[\"best_ssim\"] else lap_out\n","# #\n","# # # KERNEL_TYPE      = winner[\"kernel_type\"]\n","# # # BEST_SIGMA       = winner[\"best_sigma\"]\n","# # # BEST_NUM_KERNELS = winner[\"best_num_kernels\"]\n","# # # BEST_LAMBDA_TV   = winner[\"best_lambda_tv\"]\n","# #\n","# # # print(f\"\\n  WINNER: {KERNEL_TYPE.upper()} kernel\")\n","# # # print(f\"  sigma={BEST_SIGMA:.4f}, num_kernels={BEST_NUM_KERNELS}, lambda_tv={BEST_LAMBDA_TV:.2e}\")\n","# # # print(f\"  mean train MSE  = {winner['best_mse']:.6f}\")\n","# # # print(f\"  mean train PSNR = {winner['best_psnr']:.2f}\")\n","# # # print(f\"  mean train SSIM = {winner['best_ssim']:.4f}\")\n","# # # print(f\"  search used {len(search_train_indices)} slices\")\n","# # # print(\"=\"*55)\n","\n","# # ── Hyperparameter search skipped ─────────────────────────────────────────────\n","# # The full Bayesian search cell is commented out above to avoid rerunning the\n","# # slow optimization. These are the best parameters already found in this notebook.\n","\n","# kernel_opt = MultiSliceKernelOptimizer(target_images, mask, device=device)\n","# KERNEL_TYPE      = \"laplacian\"\n","# BEST_SIGMA       = 8.5676\n","# BEST_NUM_KERNELS = 1936\n","# BEST_LAMBDA_TV   = 1.07e-06\n","\n","# print(\"Hyperparameter search skipped; using hardcoded SSIM-optimized values.\")\n","# print(f\"Using {KERNEL_TYPE.upper()} kernel: sigma={BEST_SIGMA:.4f}, \"\n","#       f\"num_kernels={BEST_NUM_KERNELS}, lambda_tv={BEST_LAMBDA_TV:.2e}\")"]},{"cell_type":"code","source":["# ── fix dynamo before anything else ───────────────────────────────────────────\n","import torch\n","torch._dynamo.config.disable = True  # prevents the _utils crash\n","\n","import optuna\n","import pandas as pd\n","import numpy as np\n","import torch.nn.functional as F\n","import types\n","optuna.logging.set_verbosity(optuna.logging.WARNING)\n","\n","# ── batched TV loss ────────────────────────────────────────────────────────────\n","def tv_loss_batched(x):\n","    return (torch.mean(torch.abs(x[:, :, 1:, :] - x[:, :, :-1, :])) +\n","            torch.mean(torch.abs(x[:, :, :, 1:] - x[:, :, :, :-1])))\n","\n","# ── batched reconstruction ─────────────────────────────────────────────────────\n","def reconstruct_batch(self, target_images_batch, sigma, num_kernels,\n","                       lambda_tv=1e-14, max_iter=75, lr=0.01, kernel_type=None):\n","    B, C, H, W = target_images_batch.shape\n","    num_kernels = self._coerce_num_kernels(num_kernels)\n","\n","    kt = kernel_type if kernel_type is not None else KERNEL_TYPE\n","    if kt == \"laplacian\":\n","        Phi = create_laplacian_kernel_basis(\n","            grid_size=self.grid_size, num_kernels=num_kernels, sigma=float(sigma)\n","        ).to(self.device).float()\n","    else:\n","        Phi = create_gaussian_kernel_basis(\n","            grid_size=self.grid_size, num_kernels=num_kernels, sigma=float(sigma)\n","        ).to(self.device).float()\n","\n","    c = (torch.randn(B, num_kernels, C, device=self.device) * 0.01).requires_grad_(True)\n","    optimizer = torch.optim.Adam([c], lr=lr)\n","\n","    k_full = torch.fft.fftshift(\n","        torch.fft.fft2(target_images_batch, dim=(-2, -1)), dim=(-2, -1)\n","    )\n","    mask_bc = self.mask.unsqueeze(0).unsqueeze(0)\n","    y_obs = k_full * mask_bc\n","\n","    for _ in range(max_iter):\n","        optimizer.zero_grad()\n","        x_recon = torch.einsum('ki,bic->bck', Phi, c).reshape(B, C, H, W)\n","        y_recon = torch.fft.fftshift(\n","            torch.fft.fft2(x_recon, dim=(-2, -1)), dim=(-2, -1)\n","        ) * mask_bc\n","        data_loss = torch.mean(torch.abs(y_recon - y_obs) ** 2)\n","        loss = data_loss + float(lambda_tv) * tv_loss_batched(x_recon)\n","        loss.backward()\n","        optimizer.step()\n","\n","    with torch.no_grad():\n","        x_recon = torch.einsum('ki,bic->bck', Phi, c).reshape(B, C, H, W)\n","        x_recon = torch.clamp(x_recon, 0.0, 1.0)\n","        mses, psnrs, ssims = [], [], []\n","        for i in range(B):\n","            mse  = F.mse_loss(x_recon[i], target_images_batch[i]).item()\n","            psnr = 10 * torch.log10(torch.tensor(1.0 / (mse + 1e-12))).item()\n","            ssim_val = compute_ssim(\n","                x_recon[i].unsqueeze(0), target_images_batch[i].unsqueeze(0)\n","            ).item()\n","            mses.append(mse); psnrs.append(psnr); ssims.append(ssim_val)\n","\n","    return {\"mean_mse\": float(np.mean(mses)),\n","            \"mean_psnr\": float(np.mean(psnrs)),\n","            \"mean_ssim\": float(np.mean(ssims))}\n","\n","def dataset_objective_batched(self, indices, sigma, num_kernels,\n","                               lambda_tv=1e-14, max_iter=75, lr=0.01,\n","                               kernel_type=None):\n","    batch = self.target_images[indices]\n","    return self.reconstruct_batch(\n","        batch, sigma=sigma, num_kernels=num_kernels,\n","        lambda_tv=lambda_tv, max_iter=max_iter, lr=lr, kernel_type=kernel_type,\n","    )\n","\n","# ── instantiate and patch ──────────────────────────────────────────────────────\n","kernel_opt = MultiSliceKernelOptimizer(target_images, mask, device=device)\n","kernel_opt.reconstruct_batch = types.MethodType(reconstruct_batch, kernel_opt)\n","kernel_opt.dataset_objective = types.MethodType(dataset_objective_batched, kernel_opt)\n","\n","# ── Optuna search ──────────────────────────────────────────────────────────────\n","def run_mse_search(train_indices, n_trials=20, max_iter=75, lr=0.01):\n","    all_results = []\n","\n","    def objective(trial):\n","        kernel_type = trial.suggest_categorical(\"kernel_type\", [\"gaussian\", \"laplacian\"])\n","        sigma       = trial.suggest_float(\"sigma\", 2.0, 15.0)\n","        num_kernels = trial.suggest_int(\"num_kernels\", 400, 3600, step=100)\n","        lambda_tv   = trial.suggest_float(\"lambda_tv\", 1e-6, 1e-2, log=True)\n","\n","        stats = kernel_opt.dataset_objective(\n","            train_indices, sigma=sigma, num_kernels=num_kernels,\n","            lambda_tv=lambda_tv, max_iter=max_iter, lr=lr,\n","            kernel_type=kernel_type,\n","        )\n","\n","        all_results.append({\n","            \"kernel_type\": kernel_type, \"sigma\": sigma,\n","            \"num_kernels\": num_kernels, \"lambda_tv\": lambda_tv,\n","            **stats,\n","        })\n","\n","        print(\n","            f\"[{len(all_results):02d}] {kernel_type:10s} | \"\n","            f\"sigma={sigma:.3f}, kernels={num_kernels}, tv={lambda_tv:.1e} | \"\n","            f\"MSE={stats['mean_mse']:.6f}, PSNR={stats['mean_psnr']:.2f}, \"\n","            f\"SSIM={stats['mean_ssim']:.4f}\"\n","        )\n","        return stats[\"mean_mse\"]\n","\n","    study = optuna.create_study(\n","        direction=\"minimize\",\n","        sampler=optuna.samplers.TPESampler(seed=42)\n","    )\n","    study.enqueue_trial({\"kernel_type\": \"gaussian\",  \"sigma\": 4.0, \"num_kernels\": 900,  \"lambda_tv\": 1e-4})\n","    study.enqueue_trial({\"kernel_type\": \"laplacian\", \"sigma\": 6.0, \"num_kernels\": 1600, \"lambda_tv\": 1e-4})\n","    study.enqueue_trial({\"kernel_type\": \"laplacian\", \"sigma\": 8.5, \"num_kernels\": 2000, \"lambda_tv\": 1e-6})\n","\n","    study.optimize(objective, n_trials=n_trials, show_progress_bar=True)\n","\n","    search_results_df = pd.DataFrame(all_results).sort_values(\"mean_mse\")\n","    display(search_results_df)\n","\n","    return study.best_params, search_results_df\n","\n","\n","best_params, search_results_df = run_mse_search(\n","    train_indices=train_indices,   # all training images, no subsampling\n","    n_trials=20,\n","    max_iter=75,\n","    lr=0.01,\n",")\n","\n","KERNEL_TYPE      = best_params[\"kernel_type\"]\n","BEST_SIGMA       = best_params[\"sigma\"]\n","BEST_NUM_KERNELS = best_params[\"num_kernels\"]\n","BEST_LAMBDA_TV   = best_params[\"lambda_tv\"]\n","\n","print(f\"\\nBes